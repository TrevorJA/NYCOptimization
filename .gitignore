# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# ============================================================================
# outputs/ is NOT tracked. Everything under it (result CSVs, reference sets,
# figures, HDF5, manifests, ...) is machine-local and regenerable from the
# tracked workflow/ scripts + env files. The only synced figures are the
# final manuscript set in figures/manuscript/ (outside outputs/).
# If a specific result must travel between machines, copy it out of band
# (rsync/scp) rather than committing it.
# ============================================================================
outputs/

# Top-level figures: exploratory per-scenario figures are machine-local;
# only the final manuscript figure set is synced.
figures/*
!figures/manuscript/

# Borg MOEA (licensed, not distributed)
lib/borg/
*.so
*.dll

# HPC
*.log
*.err
*.out
slurm-*.out
logs/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary
*.hdf5
*.json.tmp
.claude
.pytest_cache/

MOEAFramework-5.0/
*.so.old
*.so.bak
local_notes/
docs/notes/literature/pdfs/
docs/notes/literature/notes/
docs/notes/literature/fulltext/

# Ad-hoc sandbox (never referenced by workflow/ or src/)
scripts/temporary/*
!scripts/temporary/.gitkeep