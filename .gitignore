# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# ============================================================================
# Generated outputs — cross-machine sync policy
#   SHARE : small text results (*.csv, *.json, *.md), Borg solution sets
#           (*.set), run configs (*.env) — the primary results, synced.
#   LOCAL : figures — regenerated per machine and never synced, so a laptop
#           figure can never masquerade as an Anvil result.
#   NEVER : large regenerable binaries (simulation HDF5, caches).
# Guard by file TYPE (robust as new experiments appear), plus the wholesale
# staging dirs that are large in their entirety.
# ============================================================================

# Large regenerable binaries — ignore anywhere under outputs/
outputs/**/*.hdf5
outputs/**/*.h5
outputs/**/*.pkl
outputs/**/*.npz
outputs/**/*.npy
outputs/**/*.parquet

# Solver scratch / large intermediate dumps (regenerable)
outputs/**/runtime/
outputs/**/checkpoints/

# Figures — machine-local, never shared (regenerate from tracked scripts+data)
outputs/**/*.png
outputs/**/*.pdf
outputs/**/*.svg
outputs/**/*.jpg
outputs/**/*.jpeg
outputs/**/*.eps

# Wholesale-large / legacy staging dirs (regenerable in their entirety)
outputs/optimization/
outputs/diagnostics/
outputs/reevaluation/
outputs/reference_sets/
outputs/baseline/
outputs/presim/
outputs/run_manifests/
outputs/synthetic_ensembles/

# Borg MOEA (licensed, not distributed)
lib/borg/
*.so
*.dll

# MOEAFramework
tools/

# HPC
*.log
*.err
*.out
slurm-*.out

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary
*.hdf5
*.json.tmp
.claude

MOEAFramework-5.0/
*.so.old
*.so.bak
local_notes/
docs/notes/literature/pdfs/
docs/notes/literature/notes/
docs/notes/literature/fulltext/

# Ad-hoc sandbox: ignore its contents, but keep the deliberately-tracked
# deck builder (force-added) so it syncs across machines.
scripts/temporary/*
!scripts/temporary/.gitkeep
!scripts/temporary/build_proposal_motivation_deck.py