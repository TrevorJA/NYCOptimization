# ensemble_cost - identity for the t_eval(N, L, model) cost-surface benchmark
# (workflow/supplemental/ensemble_cost_stage_submit.sh -> ensemble_cost_sweep.sh):
# the campaign evaluation path (8-objective FFMP, no LSTM) on a stationary
# Kirsch-Nowak stand-in ensemble of the swept shape. The swept knobs
# (NYCOPT_SCALING_KN_REALS, NYCOPT_SCALING_KN_YEARS, NYCOPT_USE_TRIMMED_MODEL)
# are exported per cell by the sweep script and must not be set here.
# PREREQUISITE: each (N, L) cell staged by steps 02 -> 04 under
# NYCOPT_SCENARIO_DESIGN=scaling_stationary (ensemble_cost_stage_submit.sh).
# No PYWRDRB_SIM_* / DEBUG_SIM here: the ensemble window comes from _meta.json.

NYCOPT_SCENARIO_DESIGN="scaling_stationary"
NYCOPT_MOEA_CONFIG="pilot"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct"
NYCOPT_CLUSTER="anvil"
