# ffmp_obj8_historic_moderate — moderate-scale first full-workflow run of the
# historic single-trace 8-objective FFMP baseline (no LSTM). Identical to
# ffmp_obj8_historic.env / ffmp_obj8_historic_pilot.env except the MOEA config
# is the 50k-NFE `mm_moderate` (25,000 NFE/island x 2 islands, 511 ranks on
# 4 Anvil wholenode nodes), single seed.
# Used for the first end-to-end optimization + DU re-evaluation run before any
# larger campaign.
#
# Submit: sbatch --export=ALL,NYCOPT_ENV_FILE=workflow/envs/ffmp_obj8_historic_moderate.env \
#                --array=1 --time=08:00:00 workflow/06_run_mmborg.sh

NYCOPT_SCENARIO_DESIGN="historic"
NYCOPT_MOEA_CONFIG="mm_moderate"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
NYCOPT_REEVAL_MODE="mpi"
