# transfer_evaluation - run identity for the transfer-evaluation matrix
# (docs/notes/methods/transfer_evaluation.md; supplemental_config TEV_*).
#
# Evaluates each campaign design's adopted Pareto set under the OTHER designs'
# search ensembles. Evaluation-relevant knobs are copied verbatim from the
# three production env files, which are byte-identical to each other on every
# one of them (only NYCOPT_SCENARIO_DESIGN and NYCOPT_SEARCH_REALIZATION_BATCH
# differ), so one job can serve all three sources.
#
# NYCOPT_SCENARIO_DESIGN is deliberately `historic`: every target ensemble is
# passed to evaluate_annual_units as an explicit ensemble_spec, so the active
# scenario is never read on the evaluation path, and `historic` lets config
# import without a staged search ensemble.
#
# NYCOPT_SEARCH_N=100 is load-bearing. The adopted .set files were searched on
# the N=100 draw-0 ensembles (2026-08-11/12); src/scenario_designs.py raised
# the default to 300 on 2026-08-26 (commit 3890f88), and no n300 ensemble is
# staged. Without this pin, resolve_search_spec(0) returns an unstaged slug.
# The driver asserts the resolved target's N and L against these values.
#
# Used by every workflow/supplemental/transfer_evaluation_*.sh wrapper. Smoke
# mode is a separate switch: --export=ALL,NYCOPT_TEV_SMOKE=1.

NYCOPT_SCENARIO_DESIGN="historic"
NYCOPT_SEARCH_N=100

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_deficit_cvar90_pct,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
