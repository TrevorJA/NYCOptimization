# ffmp_obj8_historic - historic single-trace 8-objective FFMP env (no LSTM)
# under the pre-campaign `mm_full` MOEA config (4 islands x 40 workers, 50k
# NFE). Campaign runs use ffmp_obj8_historic_production.env (`production`).
#
# Submit (--array index = Borg seed):
#   sbatch --export=ALL,NYCOPT_ENV_FILE=workflow/envs/ffmp_obj8_historic.env \
#          --array=1 workflow/06_run_mmborg.sh

# Run axes (scenario design + MOEA config); outputs -> outputs/{scenario}/{slug}/.
# See src/scenario_designs.py + src/moea_config.py.
NYCOPT_SCENARIO_DESIGN="historic"
# mm_full: pre-campaign 50k-NFE config; the campaign config is `production`.
NYCOPT_MOEA_CONFIG="mm_full"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
NYCOPT_REEVAL_MODE="mpi"

# Adopted incumbent-relative regret tolerance vector; derivation in
# docs/notes/methods/regret_tolerance_diagnostics.md.
NYCOPT_REGRET_TAU_K=1
NYCOPT_REGRET_TAU='{"nyc_delivery_reliability_annual": 0.02, "nyc_delivery_deficit_p99_pct": 2.0, "montague_flow_reliability_annual": 0.02, "montague_flow_deficit_p99_pct": 2.0, "trenton_flow_reliability_annual": 0.02, "downstream_flood_exceedance_annual": 0.25, "nyc_storage_min_p01_pct": 5.0, "nj_delivery_reliability_annual": 0.02}'
