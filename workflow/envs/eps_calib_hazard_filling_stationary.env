# eps_calib_hazard_filling_stationary — epsilon-calibration run identity for
# the HAZARD_FILLING_STATIONARY (contribution) scenario design.
#
# Used by workflow/supplemental/epsilon_calibration.sh; sample size, seed, and
# analysis settings live in supplemental_config.py (EPS_* section). The
# calibration evaluates on this design's staged search ensemble (draw 0,
# NYCOPT_ENSEMBLE_DRAW default) through the same batched path Borg workers run
# — i.e. under the deliberately hazard-shifted search measure.
#
# PREREQUISITES: workflow steps 01 (presim) and 02 -> 03 -> 04 (candidate pool,
# hazard-filling selection, prep) with
# NYCOPT_SCENARIO_DESIGN=hazard_filling_stationary.

NYCOPT_SCENARIO_DESIGN="hazard_filling_stationary"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_days_minor,nyc_storage_p5_pct"
NYCOPT_CLUSTER="anvil"
