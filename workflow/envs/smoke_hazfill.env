# smoke_hazfill — end-to-end pipeline check for the CAMPAIGN hazard-filling
# design (hazard_filling_stationary), step 06 only. Dev utility, not a method
# choice: the `smoke` MOEA config's NFE is a plumbing exercise.
#
# This is the ensemble counterpart to smoke.env (which is historic
# single-trace). It is also the first exercise of the 2026-08-06
# allocation-reduction DV decode (src/simulation.py::_apply_ffmp_params)
# inside a real Borg search — no optimization output predates that change.
#
# NOTE on DEBUG_SIM: ensemble windows are derived from the staged ensemble's
# own _meta.json (start_date + realization_years; src/simulation.py::
# _ensemble_window), so the PYWRDRB_SIM_* overrides DEBUG_SIM exports apply to
# single-trace (historic) runs only and cannot shorten an ensemble smoke.
# workflow/submit_smoke.sh hardcodes DEBUG_SIM=true for the historic design —
# submit this env through 06_run_mmborg.sh directly instead (see below).
#
# PREREQUISITE: the search ensemble must be staged (steps 02 -> 03 -> 04 with
# NYCOPT_SCENARIO_DESIGN=hazard_filling_stationary). Draws d0-d2 are staged as
# of 2026-08-07; the MM-Borg pre-flight fails fast otherwise.
#
# Submit (Anvil debug queue: 2 nodes x 40 tasks, 2 h cap; 79 MPI ranks =
# 1 controller + 2 islands x (38 workers + 1 master)). At the measured
# 173.8 s/eval for N=100/L=10 and 0.729 efficiency, the smoke's 400 total NFE
# is ~21 min of eval time on 76 workers — inside the 2 h cap, but note this
# is FULL-COST evaluation, not the ~13 s/eval DEBUG_SIM shortcut:
#
#   sbatch --partition=debug --nodes=2 --ntasks-per-node=40 --time=02:00:00 \
#          --job-name=smoke_hazfill \
#          --export=ALL,NYCOPT_ENV_FILE=workflow/envs/smoke_hazfill.env,\
# FORMULATION=ffmp,RUN_SLUG=smoke_hazfill,NTASKS_MPI=79 \
#          workflow/06_run_mmborg.sh
#
# `debug` is often unusable: on 2026-08-07 it had 10 of 17 nodes drain/down and
# a 2-node request was scheduled ~16 h out. The `shared` partition bills per
# allocated CPU (TRESBillingWeights=CPU=1.0) rather than per exclusive node, so
# it is both faster to schedule and cheaper for a smoke. 41 ranks =
# 1 controller + 2 islands x (19 workers + 1 master) fits one shared node:
#
#   sbatch --partition=shared --nodes=1 --ntasks=41 --time=02:00:00 \
#          --job-name=smoke_hazfill \
#          --output=logs/mmborg_smoke_hazfill_%j.out \
#          --error=logs/mmborg_smoke_hazfill_%j.err \
#          --export=ALL,NYCOPT_ENV_FILE=workflow/envs/smoke_hazfill.env,\
# FORMULATION=ffmp,RUN_SLUG=smoke_hazfill,NTASKS_MPI=41,SEED=1 \
#          <<'SBEOF'
#   #!/bin/bash
#   set -euo pipefail
#   cd "${SLURM_SUBMIT_DIR}"
#   bash workflow/06_run_mmborg.sh
#   SBEOF
#
# The heredoc wrapper is REQUIRED on `shared`: 06_run_mmborg.sh's header carries
# `#SBATCH --exclusive` (correct for wholenode, where you are billed for all 128
# cores anyway), and Slurm rejects `--exclusive` + `--oversubscribe` as mutually
# exclusive at parse time rather than letting the command line win. Submitting a
# thin wrapper that calls the launcher as a plain script sidesteps the header's
# directives without editing the production launcher. Verify after submitting
# that `scontrol show job <id>` reports `billing=41`, not 128.

NYCOPT_SCENARIO_DESIGN="hazard_filling_stationary"
NYCOPT_MOEA_CONFIG="smoke"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
NYCOPT_REEVAL_MODE="mpi"
