# smoke_hazfill - dev-only end-to-end check of the hazard_filling_stationary
# design through step 06 at the `smoke` NFE (ensemble counterpart of smoke.env;
# the ensemble window comes from the staged _meta.json, so DEBUG_SIM cannot
# shorten it). Prerequisite: steps 02 -> 03 -> 04 with
# NYCOPT_SCENARIO_DESIGN=hazard_filling_stationary.
# Submit on the shared partition through a thin wrapper (06's header pins --exclusive):
#   sbatch --partition=shared --nodes=1 --ntasks=41 --time=02:00:00 --job-name=smoke_hazfill \
#          --export=ALL,NYCOPT_ENV_FILE=workflow/envs/smoke_hazfill.env,FORMULATION=ffmp,RUN_SLUG=smoke_hazfill,NTASKS_MPI=41,SEED=1 \
#          --wrap='bash workflow/06_run_mmborg.sh'

NYCOPT_SCENARIO_DESIGN="hazard_filling_stationary"
NYCOPT_MOEA_CONFIG="smoke"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
NYCOPT_REEVAL_MODE="mpi"
