# ffmp_obj8_hazfill_stat_production — campaign run of the stationary
# hazard-filling scenario design (8-objective FFMP, no LSTM) under the
# `production` MOEA config: N=300 x L=10 search ensemble (draw 0, selected from
# the d0 P=10^6 pool), 4 islands x 382 workers = 1,533 ranks on 12 Anvil
# wholenode nodes, seed 1 at 750k total NFE and seed 2 at 500k, both reported
# at 500k (docs/notes/methods/campaign_design.md). Its exact statistical
# control is ffmp_obj8_fixedprob_production.env (same generator, same N and L,
# same MOEA config — only the selection rule differs).
#
# SLUG NOTE: `production` is config._DEFAULT_MOEA_SLUG_CONFIG, so derive_slug()
# appends NO algorithm suffix — outputs land in outputs/hazard_filling_stationary/ffmp_obj8/.
# Both seeds share that directory; the per-seed NFE difference lives in the
# MOEA config, not the slug, so the step-07 merge and the step-08/09
# re-evaluation see one run per design.
#
# PREREQUISITE: the search ensemble must be staged at N=300 first — workflow
# steps 02 (candidate pool + hazard image) -> 03 (hazard-filling
# selection; pass NYCOPT_CANDIDATE_POOL_N=1000000) -> 04 (prep pywrdrb inputs), each with NYCOPT_SCENARIO_DESIGN=hazard_filling_stationary (draw 0 is
# searched; draws 1-2 are staged for the SI draw-sensitivity re-evaluation).
# Until then the MM-Borg pre-flight fails fast with a staging message.
#
# GEOMETRY: `production` needs 1,533 MPI ranks = 12 nodes x 128, so the
# step-06 header default (--nodes=4) is too small and nycopt_check_allocation
# aborts with exit 3. Pass --nodes=12 explicitly. Twelve nodes because a
# 750k-NFE search at N=300 projects to ~99 h on eight (above the 96 h cap;
# no resume). Expected wall on the measured basis: seed 1 (750k NFE) 66-77 h
# at ~102-118k SU; seed 2 (500k NFE) 44-51 h at ~68-79k SU (the range is the
# unmeasured 8 -> 12 node scaling). Seed 1's runtime snapshot at 125,000
# NFE/island (~2/3 of its wall) is the equal-NFE result and survives a kill
# at the wall.
#
# Submit ONE seed per sbatch (per-seed NFE and --time; DRAW=0 is the campaign):
#   sbatch --export=ALL,NYCOPT_ENV_FILE=workflow/envs/ffmp_obj8_hazfill_stat_production.env,DRAW=0 #          --array=1 --nodes=12 --ntasks-per-node=128 --time=96:00:00 #          workflow/06_run_mmborg.sh
#   sbatch --export=ALL,NYCOPT_ENV_FILE=workflow/envs/ffmp_obj8_hazfill_stat_production.env,DRAW=0 #          --array=2 --nodes=12 --ntasks-per-node=128 --time=72:00:00 #          workflow/06_run_mmborg.sh
# Submit seed 2 only after seed 1 has priced the campaign (campaign_design.md §6).

NYCOPT_SCENARIO_DESIGN="hazard_filling_stationary"
NYCOPT_MOEA_CONFIG="production"
# Two Pywr model runs per evaluation (150 + 150 realizations). Required at
# 128 ranks/node: N=300 unbatched projects to ~259 GB/node against the
# 217 GB safety line; batched it projects to ~167 GB (config.search_node_rss_gb;
# the step-06 pre-flight refuses to launch without it). Results are identical
# to the unbatched path; time penalty <= 9 % (measured at N=20).
NYCOPT_SEARCH_REALIZATION_BATCH=150

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
NYCOPT_REEVAL_MODE="mpi"

# Incumbent-relative regret tolerance â€” RE-ADOPTED 2026-08-14 from pass B, on
# ROUND stakeholder-interpretable values. Supersedes the 2026-08-08 pass-A
# vector (0.134/10/0.130/10/0.122/0.927/5.76/0.137), which was built from an
# UNPAIRED noise floor and was 5.7-21.8x too large on the five axes where the
# floor set tau: at that tolerance every design scored no_harm_freq_tau = 1.000
# with a paired bootstrap SE of exactly 0, i.e. the RQ1 non-inferiority result
# was produced by the tolerance rather than measured, and assay sensitivity
# FAILED (the metric could not separate the unmatched `historic` control).
#
# Each value is round AND anchored (pass-B evidence, rtolB_*.csv):
#   reliabilities 0.02  = the PAIRED near-tie floor (0.0171-0.0240 at z=1.645);
#                         24.5x the metric granularity (1/1225); 6% of the
#                         incumbent's own q10-q90 spread (the old 0.134 was 42%);
#                         below the median real degradation on every axis.
#   deficit P99   2 pp   = clears the Montague floor (1.23), far below the
#                         -13..-27 pp degradations actually present, so the
#                         binding Montague harm is reported, not hidden.
#   flood        0.25    = 5.9x the paired floor (0.043), 0.83x the search
#                         epsilon (0.3). NOT the rounder 0.10: that starves the
#                         compromise panel (fixedprob median 0.040 < 0.05).
#   storage      5 pp    = the one axis where all three anchors already agree
#                         and are round (eps 5.0, unpaired 5.76, paired 3.02).
#
# Resulting behaviour: assay sensitivity HOLDS on both endpoints, neither is
# saturated or starved. REPORT ALONGSIDE: the matched-design ordering on the
# all-8 metric is a function of the flood tolerance alone (fixedprob and
# hazard-filling cross between tau_flood 0.25 and 0.30).
#
# Whole-vector override consumed by src.robustness.tau_ladder (scaled by k for
# the ladder sweep). Evidence: outputs/supplemental/regret_tolerance_diagnostics/
# tables/rtolB_paired_floor_check.csv, rtolB_candidate_grid_ranked.csv.
NYCOPT_REGRET_TAU_K=1
NYCOPT_REGRET_TAU='{"nyc_delivery_reliability_annual": 0.02, "nyc_delivery_deficit_p99_pct": 2.0, "montague_flow_reliability_annual": 0.02, "montague_flow_deficit_p99_pct": 2.0, "trenton_flow_reliability_annual": 0.02, "downstream_flood_exceedance_annual": 0.25, "nyc_storage_min_p01_pct": 5.0, "nj_delivery_reliability_annual": 0.02}'
