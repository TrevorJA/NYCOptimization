# ffmp_obj8_historic_production - campaign run of the historic single-trace
# 8-objective FFMP reference (no LSTM) under the `production` MOEA config:
# 4 islands x 382 workers = 1,533 ranks on 12 Anvil wholenode nodes; seed 1 at
# 750k total NFE, seed 2 at 1.25M (NYCOPT_MAX_EVALUATIONS_BY_SEED below, the
# 2026-11-11 convergence test; the shared `production` entry keeps seed 2 at
# 500k for the ensemble designs), both reported at 500k
# (docs/notes/methods/campaign_design.md). The single-trace reference of the
# matched-NFE comparison against the two ensemble designs.
#
# `production` is the default moea-slug config, so outputs land in
# outputs/historic/ffmp_obj8/ (both seeds share the directory). One trace, so
# no realization batch; the run is NFE-bounded, so request ~8 h (seed 1) or
# ~12 h (seed 2 at 1.25M) rather than the 96 h header default.
#
# Submit ONE seed per job through the helper, which holds the geometry
# (--nodes=12 --ntasks-per-node=128) and the per-seed --time (8 h / 12 h);
# historic accepts draw 0 only:
#   bash workflow/submit_production_search.sh historic 1
#   bash workflow/submit_production_search.sh historic 2   # after seed 1 lands

NYCOPT_SCENARIO_DESIGN="historic"
NYCOPT_MOEA_CONFIG="production"
# Per-island NFE by seed (seed 1: 187,500 = 750k total; seed 2: 312,500 =
# 1.25M total). Overrides `production`'s max_evaluations_by_seed for this
# design only; the reporting NFE stays 125,000 per island.
NYCOPT_MAX_EVALUATIONS_BY_SEED="187500,312500"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_deficit_cvar90_pct,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_REEVAL_MODE="mpi"

# Adopted incumbent-relative regret tolerance vector; derivation in
# docs/notes/methods/regret_tolerance_diagnostics.md.
NYCOPT_REGRET_TAU_K=1
NYCOPT_REGRET_TAU='{"nyc_delivery_reliability_annual": 0.02, "nyc_delivery_deficit_p99_pct": 2.0, "montague_flow_reliability_annual": 0.02, "montague_flow_deficit_p99_pct": 2.0, "trenton_flow_deficit_p99_pct": 2.0, "downstream_flood_exceedance_annual": 0.25, "nyc_storage_min_p01_pct": 5.0, "nj_delivery_reliability_annual": 0.02}'
