# ffmp_obj8_historic_production — production-scale (500k-NFE `production`,
# 125,000 NFE/island x 4 islands, 1,021 ranks on 8 Anvil wholenode nodes) run
# of the historic single-trace 8-objective FFMP baseline (no LSTM). Identical
# to ffmp_obj8_historic.env / ffmp_obj8_historic_moderate.env except for the
# MOEA config. This is the single-trace reference arm of the matched-NFE
# comparison against the two ensemble designs.
#
# SLUG NOTE: `production` is config._DEFAULT_MOEA_SLUG_CONFIG, so derive_slug()
# appends NO algorithm suffix — outputs land in outputs/historic/ffmp_obj8/
# (not ..._production/). That is a fresh path; it does not collide with the
# existing ffmp_obj8_mm_full sets, and the step-06 pre-flight's
# refuse-to-relaunch guard will not fire on it.
#
# COST: the historic single trace evaluates in ~32 s vs ~174 s for the N=100,
# L=10 ensemble designs, so at equal NFE this arm is ~5x cheaper — ~6 h /
# ~6,100 SU projected for 500k NFE at the production geometry, against ~33 h /
# ~33,400 SU for each ensemble arm. Matched NFE (not matched cost) is the
# validity condition for the cross-design comparison.
#
# GEOMETRY: `production` needs 1,021 MPI ranks = 8 nodes x 128, so the step-06
# header default (--nodes=4) is too small and nycopt_check_allocation aborts
# with exit 3. Pass --nodes=8 explicitly. Ask for ~10 h here (the arm is
# ~5x cheaper than the ensemble arms), NOT the 96 h header default: the run is
# NFE-bounded and a shorter request backfills far sooner on a busy queue.
#
# Submit (--array = Borg seed; historic accepts draw 0 only):
#   sbatch --export=ALL,NYCOPT_ENV_FILE=workflow/envs/ffmp_obj8_historic_production.env \
#          --array=1 --nodes=8 --ntasks-per-node=128 --time=10:00:00 \
#          workflow/06_run_mmborg.sh

NYCOPT_SCENARIO_DESIGN="historic"
NYCOPT_MOEA_CONFIG="production"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
NYCOPT_REEVAL_MODE="mpi"

# Incumbent-relative regret tolerance — ADOPTED 2026-08-08 from regret-tolerance
# pass A on the step-05 incumbent E_test cube (per-SOW annual-unit substrate).
# Ladder shape = max(eps_i, noise floor_i) at headline rung k=1: six of eight
# epsilons sit below their measured per-SOW noise floors, so the eps-shape
# ladder cannot carry a shared k. Whole-vector override consumed by
# src.robustness.tau_ladder; floors artifact:
# outputs/supplemental/regret_tolerance_diagnostics/tables/rtol_floors.json.
NYCOPT_REGRET_TAU_K=1
NYCOPT_REGRET_TAU='{"nyc_delivery_reliability_annual": 0.1342157494928577, "nyc_delivery_deficit_p99_pct": 10.0, "montague_flow_reliability_annual": 0.13034719305518638, "montague_flow_deficit_p99_pct": 10.0, "trenton_flow_reliability_annual": 0.12182288458257644, "downstream_flood_exceedance_annual": 0.9265026547022509, "nyc_storage_min_p01_pct": 5.757741945985054, "nj_delivery_reliability_annual": 0.13724713377479272}'
