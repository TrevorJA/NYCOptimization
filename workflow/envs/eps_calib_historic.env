# eps_calib_historic — epsilon-calibration run identity for the HISTORIC
# (single-trace reference) scenario design.
#
# Used by workflow/supplemental/epsilon_calibration.sh; sample size, seed, and
# analysis settings live in supplemental_config.py (EPS_* section). The
# historic design enters the annual-unit scheme as N=1 over the trace's
# consecutive water-year units; its noise floor is bootstrapped over unit-years
# (i.i.d. approximation, disclosed).
#
# PREREQUISITE: workflow step 01 (presim for the trimmed model).

NYCOPT_SCENARIO_DESIGN="historic"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_days_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
