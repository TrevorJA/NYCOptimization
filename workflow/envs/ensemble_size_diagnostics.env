# ensemble_size_diagnostics — run identity for the ensemble-size diagnostics
# (docs/notes/methods/ensemble_size_diagnostics.md; supplemental_config ESD_*).
#
# The hazard-filling design is the identity so that its own pool slug and
# selector-seed function resolve (Layer A scores the campaign selector; the
# library regenerates members of the design's P=1e6 pool d0). The candidate
# pool size MUST be pinned here: the registry default is the P=2,000 smoke
# pool (TODO.md §1, defect b).
#
# Used by every workflow/supplemental/ensemble_size_*.sh wrapper. Smoke mode
# is a separate switch: --export=ALL,NYCOPT_ESD_SMOKE=1.

NYCOPT_SCENARIO_DESIGN="hazard_filling_stationary"
NYCOPT_CANDIDATE_POOL_N=1000000

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
