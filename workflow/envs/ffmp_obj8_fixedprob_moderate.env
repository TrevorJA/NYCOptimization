# ffmp_obj8_fixedprob_moderate — moderate-scale (50k-NFE `mm_moderate`,
# 25,000 NFE/island x 2 islands, 511 ranks on 4 Anvil wholenode nodes) run of
# the fixed probabilistic scenario design (8-objective FFMP, no LSTM), single
# seed, draw 0. One half of the first matched design-pair runs; it is the
# exact statistical control for ffmp_obj8_hazfill_stat_moderate.env (same
# generator, same N and L, same MOEA config — only the selection rule differs).
#
# PREREQUISITE: the search ensemble must be staged first — workflow steps
# 02 (generate the design's own realizations) -> 04 (prep pywrdrb inputs),
# each with NYCOPT_SCENARIO_DESIGN=fixed_probabilistic. Until then the
# MM-Borg pre-flight fails fast with a staging message.
#
# Submit: sbatch --export=ALL,NYCOPT_ENV_FILE=workflow/envs/ffmp_obj8_fixedprob_moderate.env \
#                --array=1 --time=08:00:00 workflow/06_run_mmborg.sh

NYCOPT_SCENARIO_DESIGN="fixed_probabilistic"
NYCOPT_MOEA_CONFIG="mm_moderate"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
NYCOPT_REEVAL_MODE="mpi"
