# ffmp_obj8_fixedprob_production - campaign run of the fixed_probabilistic
# scenario design (8-objective FFMP, no LSTM) under the `production` MOEA
# config: N=300 x L=10 search ensemble, draw 0; 4 islands x 382 workers =
# 1,533 ranks on 12 Anvil wholenode nodes; seed 1 at 750k total NFE, seed 2 at
# 500k, both reported at 500k (docs/notes/methods/campaign_design.md). Exact
# statistical control for ffmp_obj8_hazfill_stat_production.env (same
# generator, N, L and MOEA config; only the selection rule differs).
#
# `production` is the default moea-slug config, so outputs land in
# outputs/fixed_probabilistic/ffmp_obj8/ (both seeds share the directory).
#
# PREREQUISITE: steps 02 -> 04 at N=300 with
# NYCOPT_SCENARIO_DESIGN=fixed_probabilistic (draws 0-2 staged; draw 0 searched).
#
# Submit ONE seed per sbatch (production needs --nodes=12 --ntasks-per-node=128;
# submit seed 2 after seed 1):
#   sbatch --export=ALL,NYCOPT_ENV_FILE=workflow/envs/ffmp_obj8_fixedprob_production.env,DRAW=0 \
#          --array=1 --nodes=12 --ntasks-per-node=128 --time=96:00:00 workflow/06_run_mmborg.sh
#   sbatch --export=ALL,NYCOPT_ENV_FILE=workflow/envs/ffmp_obj8_fixedprob_production.env,DRAW=0 \
#          --array=2 --nodes=12 --ntasks-per-node=128 --time=72:00:00 workflow/06_run_mmborg.sh

NYCOPT_SCENARIO_DESIGN="fixed_probabilistic"
NYCOPT_MOEA_CONFIG="production"
# Two Pywr model runs per evaluation (150 + 150 realizations): N=300 unbatched
# exceeds the node-memory safety line at 128 ranks/node (config.search_node_rss_gb;
# the step-06 pre-flight refuses to launch without it). Results are identical to
# the unbatched path.
NYCOPT_SEARCH_REALIZATION_BATCH=150

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
NYCOPT_REEVAL_MODE="mpi"

# Adopted incumbent-relative regret tolerance vector; derivation in
# docs/notes/methods/regret_tolerance_diagnostics.md.
NYCOPT_REGRET_TAU_K=1
NYCOPT_REGRET_TAU='{"nyc_delivery_reliability_annual": 0.02, "nyc_delivery_deficit_p99_pct": 2.0, "montague_flow_reliability_annual": 0.02, "montague_flow_deficit_p99_pct": 2.0, "trenton_flow_reliability_annual": 0.02, "downstream_flood_exceedance_annual": 0.25, "nyc_storage_min_p01_pct": 5.0, "nj_delivery_reliability_annual": 0.02}'
