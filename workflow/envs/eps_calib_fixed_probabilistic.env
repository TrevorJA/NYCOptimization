# eps_calib_fixed_probabilistic — epsilon-calibration run identity for the
# FIXED_PROBABILISTIC (exact i.i.d. control) scenario design.
#
# Used by workflow/supplemental/epsilon_calibration.sh; sample size, seed, and
# analysis settings live in supplemental_config.py (EPS_* section). The
# calibration evaluates on this design's staged search ensemble (draw 0,
# NYCOPT_ENSEMBLE_DRAW default) through the same batched path Borg workers run.
#
# PREREQUISITES: workflow steps 01 (presim) and 02 + 04 (generate + prep the
# search ensemble) with NYCOPT_SCENARIO_DESIGN=fixed_probabilistic.

NYCOPT_SCENARIO_DESIGN="fixed_probabilistic"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
