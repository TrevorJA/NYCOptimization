# ffmp_obj8_historic_pilot — launch-verification pilot for the historic
# single-trace 8-objective FFMP baseline (no LSTM). Identical to
# ffmp_obj8_historic.env except the MOEA config is the 5k-NFE pilot, used to
# verify balance / per-eval cost / output writing before the full 50k run.

NYCOPT_SCENARIO_DESIGN="historic"
NYCOPT_MOEA_CONFIG="mm_pilot"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_NYC_NJ_DEMAND_SOURCE="constant_max"
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_reliability_weekly,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_CLUSTER="anvil"
NYCOPT_REEVAL_MODE="mpi"

# Incumbent-relative regret tolerance — ADOPTED 2026-08-08 from regret-tolerance
# pass A on the step-05 incumbent E_test cube (per-SOW annual-unit substrate).
# Ladder shape = max(eps_i, noise floor_i) at headline rung k=1: six of eight
# epsilons sit below their measured per-SOW noise floors, so the eps-shape
# ladder cannot carry a shared k. Whole-vector override consumed by
# src.robustness.tau_ladder; floors artifact:
# outputs/supplemental/regret_tolerance_diagnostics/tables/rtol_floors.json.
NYCOPT_REGRET_TAU_K=1
NYCOPT_REGRET_TAU='{"nyc_delivery_reliability_annual": 0.1342157494928577, "nyc_delivery_deficit_p99_pct": 5.0, "montague_flow_reliability_annual": 0.13034719305518638, "montague_flow_deficit_p99_pct": 5.0, "trenton_flow_reliability_annual": 0.12182288458257644, "downstream_flood_exceedance_annual": 0.9265026547022509, "nyc_storage_min_p01_pct": 5.757741945985054, "nj_delivery_reliability_annual": 0.13724713377479272}'
