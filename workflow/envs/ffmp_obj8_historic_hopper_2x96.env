# ffmp_obj8_historic_hopper_2x96 - the historic single-trace 8-objective FFMP
# search (no LSTM) sized for Hopper: `hopper_2x96` MOEA config, 4 islands x 46
# workers = 189 ranks on two 96-core EPYC nodes (HOPPER_NOTES.md). Problem
# definition, NFE budgets (seed 1 at 750k total NFE, seed 2 at 1.25M) and
# snapshot interval are those of ffmp_obj8_historic_production.env; only the
# worker count per island differs, so outputs land under their own slug,
# outputs/historic/ffmp_obj8_hopper_2x96/, never beside the Anvil sets.
#
# Submit ONE seed per job (the --array index is the Borg seed); there is no
# wall cap on Hopper and no resume, so give --time generous headroom
# (measured basis: ~34 h for 1.2M NFE at 24 s per evaluation):
#   source workflow/cluster.sh
#   sbatch --nodes=2 --ntasks-per-node=96 --time=72:00:00 --array=2 \
#          --export=ALL,NYCOPT_ENV_FILE=workflow/envs/ffmp_obj8_historic_hopper_2x96.env,DRAW=0 \
#          workflow/07_run_mmborg.sh

NYCOPT_SCENARIO_DESIGN="historic"
NYCOPT_MOEA_CONFIG="hopper_2x96"
# Per-island NFE by seed (seed 1: 187,500 = 750k total; seed 2: 312,500 =
# 1.25M total), as in the production env file; the reporting NFE stays
# 125,000 per island.
NYCOPT_MAX_EVALUATIONS_BY_SEED="187500,312500"

NYCOPT_FORMULATIONS="ffmp"
NYCOPT_SALINITY_ON=0
NYCOPT_TEMPERATURE_ON=0
NYCOPT_OBJECTIVES="nyc_delivery_reliability_weekly,nyc_delivery_deficit_cvar90_pct,montague_flow_reliability_weekly,montague_flow_deficit_cvar90_pct,trenton_flow_deficit_cvar90_pct,downstream_flood_exceedance_minor,nyc_storage_p5_pct,nj_delivery_reliability_weekly"
NYCOPT_REEVAL_MODE="mpi"

# Adopted incumbent-relative regret tolerance vector; derivation in
# docs/notes/methods/regret_tolerance_diagnostics.md.
NYCOPT_REGRET_TAU_K=1
NYCOPT_REGRET_TAU='{"nyc_delivery_reliability_annual": 0.02, "nyc_delivery_deficit_p99_pct": 2.0, "montague_flow_reliability_annual": 0.02, "montague_flow_deficit_p99_pct": 2.0, "trenton_flow_deficit_p99_pct": 2.0, "downstream_flood_exceedance_annual": 0.25, "nyc_storage_min_p01_pct": 5.0, "nj_delivery_reliability_annual": 0.02}'
